// Zed settings — converted from VS Code
// Location: ~/.config/zed/settings.json  (open with cmd-, in Zed)
// Extensions to install first (cmd-shift-x): catppuccin, catppuccin-icons, php, vue, emmet
{
  // workbench.colorTheme / workbench.iconTheme
  "cli_default_open_behavior": "existing_window",
  "edit_predictions": {
    "provider": "copilot",
  },
  "theme": {
    "mode": "light",
    "light": "Catppuccin Latte",
    "dark": "One Dark",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha",
  },

  // editor.fontFamily / fontSize / fontWeight / fontLigatures
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_fallbacks": ["Menlo", "Monaco", "Courier New"],
  // VS Code: 13px * zoomLevel 1 (= 120%) ≈ 15.6px effective. Zed has no window zoom,
  // so bump the font sizes instead. Use 13 if you want the literal value.
  "buffer_font_size": 15.6,
  "ui_font_size": 16,
  "buffer_font_weight": 700,
  "buffer_font_features": {
    "calt": true, // ligatures
  },

  // editor.cursorBlinking: "phase" -> Zed only has on/off
  "cursor_blink": true,

  // editor.bracketPairColorization.enabled
  "colorize_brackets": true,

  // editor.minimap.enabled: false
  "minimap": {
    "show": "never",
  },

  // workbench.sideBar.location: "left"
  "project_panel": {
    "dock": "left",
  },

  // claudeCode.preferredLocation: "panel" (bottom panel)
  "agent": {
    "dock": "bottom",
  },

  // files.autoSave: afterDelay / files.autoSaveDelay: 100
  "autosave": {
    "after_delay": {
      "milliseconds": 100,
    },
  },

  // editor.formatOnSave / editor.defaultFormatter
  "format_on_save": "on",
  "formatter": "auto",

  // github.copilot.enable: off everywhere except plaintext
  "show_edit_predictions": false,

  "languages": {
    // [typescript] / [typescriptreact] -> prettier
    "TypeScript": {
      "formatter": "prettier",
    },
    "TSX": {
      "formatter": "prettier",
      // emmet.includeLanguages { javascript: javascriptreact }
      "language_servers": ["emmet-language-server", "..."],
    },
    "JavaScript": {
      "formatter": "prettier",
      "language_servers": ["emmet-language-server", "..."],
    },
    // [vue] -> Volar (the vue extension ships vue-language-server)
    "Vue.js": {
      "formatter": "language_server",
    },
    // [php] -> laravel.vscode-laravel has no Zed equivalent; see notes
    "PHP": {
      "formatter": "language_server",
    },
    // copilot plaintext: true
    "Plain Text": {
      "show_edit_predictions": true,
    },
  },

  // Language-server init options live under "lsp", not "languages".
  "lsp": {
    "tinymist": {
      "initialization_options": {
        "exportPageOnSave": "pdf",
        "tinymist.preview.browsing.args": [
          "--data-plane-host=127.0.0.1:0",
          "--invert-colors=auto",
          "--open",
        ],
      },
    },
  },
}
